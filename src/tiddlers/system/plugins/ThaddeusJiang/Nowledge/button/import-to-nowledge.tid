caption: {{$:/plugins/ThaddeusJiang/Nowledge/icon/nowledge}} Nowledge Mem
created: 20250810125715658
description: Synchronize this tiddler with Nowledge Mem
modified: 20260831000000000
tags: $:/tags/ViewToolbar $:/plugins/ThaddeusJiang/Nowledge
title: $:/plugins/ThaddeusJiang/Nowledge/button/import-to-nowledge
type: text/vnd.tiddlywiki

\whitespace trim
<% if [<currentTiddler>!is[system]!has[draft.of]] %>
<$let statusTitle={{{ [<currentTiddler>encodeuricomponent[]addprefix[$:/temp/tw-nowledge/status/]] }}}>
<$let nowledgeState={{{ [<statusTitle>get[state]else[unlinked]] }}}>
<$button
  message="tm-nowledge-sync"
  param=<<currentTiddler>>
  tooltip={{{ [<statusTitle>get[message]else[Sync with Nowledge Mem]] }}}
  aria-label="Sync with Nowledge Mem"
  class=<<tv-config-toolbar-class>>
>
  {{$:/plugins/ThaddeusJiang/Nowledge/icon/nowledge}}
  <span class="tw-nowledge-state" data-state=<<nowledgeState>>>
    <$list filter="[<nowledgeState>match[unlinked]]">＋</$list>
    <$list filter="[<nowledgeState>match[synced]]">✓</$list>
    <$list filter="[<nowledgeState>match[local-changed]]">NEW</$list>
    <$list filter="[<nowledgeState>match[remote-changed]]">OLD</$list>
    <$list filter="[<nowledgeState>match[conflict]]">!</$list>
    <$list filter="[<nowledgeState>match[checking]]">…</$list>
    <$list filter="[<nowledgeState>match[error]]">×</$list>
  </span>
  <% if [<tv-config-toolbar-text>match[yes]] %>
    <span class="tc-btn-text">Mem</span>
  <% endif %>
</$button>
</$let>
</$let>
<% endif %>
