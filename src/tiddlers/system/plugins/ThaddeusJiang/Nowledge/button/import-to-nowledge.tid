caption: {{$:/plugins/ThaddeusJiang/Nowledge/icon/nowledge}} Nowledge Mem
created: 20250810125715658
description: Synchronize this tiddler with Nowledge Mem
modified: 20260831000000000
tags: $:/tags/ViewToolbar $:/plugins/ThaddeusJiang/Nowledge
title: $:/plugins/ThaddeusJiang/Nowledge/button/import-to-nowledge
type: text/vnd.tiddlywiki

\whitespace trim
<% if [<currentTiddler>!is[system]!has[draft.of]] %>
<$let statusTitle={{{ [<currentTiddler>encodeuricomponent[]addprefix[$:/temp/tw-nowledge/status/]] }}}>
<$let nowledgeState={{{ [<statusTitle>get[state]else[unlinked]] }}}>
<$button
  message="tm-nowledge-sync"
  param=<<currentTiddler>>
  tooltip={{{ [<statusTitle>get[message]else[Sync with Nowledge Mem]] }}}
  aria-label="Sync with Nowledge Mem"
  class=<<tv-config-toolbar-class>>
>
  <$list filter="[<nowledgeState>match[unlinked]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem.png" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[synced]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem-synced.svg" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[local-changed]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem-push.svg" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[remote-changed]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem-pull.svg" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[conflict]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem-conflict.svg" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[checking]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem.png" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <$list filter="[<nowledgeState>match[error]]">
    <$image source="$:/plugins/ThaddeusJiang/Nowledge/image/nmem.png" width="22" height="22" class="tc-nowledge-button tc-image-button" />
  </$list>
  <% if [<tv-config-toolbar-text>match[yes]] %>
    <span class="tc-btn-text">Mem</span>
  <% endif %>
</$button>
</$let>
</$let>
<% endif %>
